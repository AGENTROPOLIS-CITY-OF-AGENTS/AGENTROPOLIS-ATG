    "glyph_count": 24,
    "status": "ATG grammar defines SEMANTIC glyphs only (n=name, m=meaning). It defines NO canonical affect or gesture alphabet. signal_ids below are canonical glyph names verbatim; every clip/preset/affect binding is PROPOSED pending ATG-owner review."
  },
  "signal_id_format": "SPEC §2.2 signal_id is an opaque string from this map; GROK-07 uses the ATG glyph name `n` verbatim (e.g. \"AR\"). No prefix, no transformation.",
  "category_note": "SPEC §2.2 envelope requires category ∈ {affect, body_language, gesture, viseme_hint}; ATG defines no meaning groups, so category = envelope enum by layer and the glyph meaning `m` is carried verbatim in glyph_meaning.",
  "combined_form": "Each glyph emits two entries sharing one signal_id: one L1_gesture + one L3_facial. Host resolves both on one signal (layer_hint selects one if set).",
  "priority": {
    "order": [
      "facial",
      "gesture",
      "gaze"
    ],
    "rule": "Envelope `priority` first; on tie for the same channel, facial > gesture > gaze (SPEC §2.2, unchanged). Visemes override mouth shapes while speaking (SPEC §3.4).",
    "deviation_from_spec": false
  },
  "expression_constraints": {
    "max_concurrent_presets": 2,
    "max_weight_sum": 1.2,
    "blendshape_set": "ARKit52"
  },
