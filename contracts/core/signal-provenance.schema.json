{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/atg/contracts/core/signal-provenance.schema.json",
  "title": "ATG Signal Provenance",
  "description": "Implementation-neutral contract for governed provenance, authenticity signaling, and verification of ATG artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "origin", "signal", "authority", "policy", "receipt"],
  "properties": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_class", "digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "media_class": {
          "type": "string",
          "enum": ["text", "image", "video", "audio", "code", "document", "3d", "mixed", "other"]
        },
        "digest": {"type": "string", "minLength": 1},
        "digest_algorithm": {"type": "string", "default": "sha256"},
        "content_type": {"type": "string"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_class", "generator_version"],
      "properties": {
        "generator_class": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "model_family": {"type": "string"},
        "model_version": {"type": "string"},
        "district_id": {"type": "string"},
        "application_id": {"type": "string"}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "signal_class", "payload_mode", "user_tracking", "executable_semantics"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^atg\\.signal\\.[a-z0-9._-]+$"},
        "signal_class": {
          "type": "string",
          "enum": ["signed_manifest", "statistical_text", "robust_media", "detached_signature", "none"]
        },
        "profile_version": {"type": "string"},
        "key_epoch": {"type": "string"},
        "detector_version": {"type": "string"},
        "payload_mode": {"type": "string", "const": "none"},
        "user_tracking": {"type": "boolean", "const": false},
        "executable_semantics": {"type": "boolean", "const": false},
        "survives_copy": {"type": "boolean"},
        "survives_transform": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandate_id", "capability_handle"],
      "properties": {
        "mandate_id": {"type": "string", "minLength": 1},
        "capability_handle": {"type": "string", "minLength": 1},
        "signing_service_ref": {"type": "string"},
        "principal_id": {"type": "string"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "verification_required", "covert_payloads_forbidden"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "risk_policy_id": {"type": "string"},
        "verification_required": {"type": "boolean"},
        "covert_payloads_forbidden": {"type": "boolean", "const": true},
        "identity_encoding_allowed": {"type": "boolean", "const": false},
        "raw_secret_access_allowed": {"type": "boolean", "const": false},
        "auto_execute_verified_content": {"type": "boolean", "const": false}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["verified", "consistent", "inconsistent", "unknown", "not_checked", "tampered", "expired", "revoked"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "manifest_valid": {"type": "boolean"},
        "signature_valid": {"type": "boolean"},
        "artifact_digest_match": {"type": "boolean"},
        "verified_at": {"type": "string", "format": "date-time"},
        "verifier_id": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "required"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "const": true},
        "created_at": {"type": "string", "format": "date-time"},
        "policy_state": {"type": "string"},
        "manifest_ref": {"type": "string"},
        "signature_ref": {"type": "string"},
        "audit_ref": {"type": "string"},
        "parent_artifact_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  }
}
