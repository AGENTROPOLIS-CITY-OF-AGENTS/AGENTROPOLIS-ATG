{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/core/goal-contract.schema.json",
  "title": "ATG Goal Contract",
  "description": "Persistent definition-of-done contract used by HERMES or another coordinator to turn intent into bounded work without granting execution authority by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "objective", "definition_of_done", "success_tests", "constraints", "authority_profile", "state"],
  "properties": {
    "goal_id": {"type": "string", "pattern": "^goal:[A-Za-z0-9._:-]{1,128}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "success_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "description", "method"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "minLength": 1, "maxLength": 1024},
          "method": {"type": "string", "enum": ["deterministic", "human_review", "policy_check", "external_verification", "contra_challenge"]},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadline": {"type": "string", "format": "date-time"},
        "max_cost": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1, "maxLength": 32},
        "allowed_districts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "allowed_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "authority_profile": {"type": "string", "minLength": 1, "maxLength": 256},
    "work_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^work:[A-Za-z0-9._:-]{1,128}$"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "state": {"type": "string", "enum": ["draft", "active", "blocked", "awaiting_approval", "verifying", "complete", "failed", "cancelled"]}
  }
}
