{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/core/economic-mandate.schema.json",
  "title": "ATG Economic Mandate",
  "description": "A bounded economic authority object derived from an ATG mandate. It grants an agent the minimum transaction authority required for one defined economic intent. It does not grant generalized wallet, card, treasury, or credential access.",
  "type": "object",
  "additionalProperties": false,
  "required": ["economic_mandate_id", "mandate_id", "agent_id", "purpose", "value_limit", "settlement", "constraints", "approval", "enforcement"],
  "properties": {
    "economic_mandate_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "mandate_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 512},
    "counterparty_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_merchants": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 256},
        "allowed_domains": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 256},
        "allowed_addresses": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 256}
      }
    },
    "value_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "asset"],
      "properties": {
        "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$", "maxLength": 128},
        "asset": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["x402", "xrpl", "evm", "solana", "internal_xents", "fiat_bridge", "other"]},
        "network": {"type": "string", "maxLength": 128},
        "asset": {"type": "string", "maxLength": 128},
        "adapter": {"type": "string", "maxLength": 256},
        "credential_class": {"type": "string", "enum": ["capability_handle", "ephemeral_token", "single_use_card", "session_wallet", "sealed_signer", "none"]}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_uses", "delegation_allowed"],
      "properties": {
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "max_uses": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "retry_limit": {"type": "integer", "minimum": 0, "maximum": 100},
        "recurring": {"type": "boolean", "default": false},
        "delegation_allowed": {"type": "boolean", "default": false},
        "reversible_required": {"type": "boolean", "default": false},
        "target_must_belong_to_principal": {"type": "boolean", "default": false}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "method": {"type": "string", "enum": ["human_passkey", "human_physical", "quorum", "machine_policy", "dual_control", "none"]},
        "approvers": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 64}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorization_class": {"type": "string", "enum": ["A1_REVERSIBLE", "A2_BOUNDED", "A3_IRREVERSIBLE", "A4_ROOT"]},
        "contra_required": {"type": "boolean", "default": false},
        "third_party_impact_check": {"type": "boolean", "default": true}
      }
    },
    "enforcement": {"type": "string", "enum": ["advisory", "enforced"]},
    "created_at": {"type": "string", "format": "date-time"},
    "issued_by": {"type": "string", "maxLength": 256},
    "economic_mandate_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "maxLength": 72}
  }
}
