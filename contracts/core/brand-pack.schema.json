{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/core/brand-pack.schema.json",
  "title": "ATG Brand Pack",
  "description": "Versioned minimum-necessary brand contract for artifact-generating agents and applications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand_id", "version", "identity", "visual_language", "forbidden_patterns"],
  "properties": {
    "brand_id": {"type": "string", "pattern": "^brand:[A-Za-z0-9._:-]{1,128}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "voice": {"type": "string", "maxLength": 4096},
        "audience": {"type": "string", "maxLength": 2048}
      }
    },
    "typography": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "palette": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "logo_rules": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "visual_language": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "artifact_templates": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "image_generation_rules": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "accessibility_rules": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "forbidden_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  }
}
