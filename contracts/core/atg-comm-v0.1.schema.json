{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATG COMM v0.1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "origin",
    "priority",
    "payload",
    "authority",
    "ttl_minutes"
  ],
  "properties": {
    "version": {
      "const": "ATG/COMM/1.0"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "CRITICAL"
      ]
    },
    "payload": {
      "type": "string"
    },
    "authority": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "REVOKED",
        "UNKNOWN"
      ]
    },
    "ttl_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "message_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dialect": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "signature_reference": {
      "type": "string"
    },
    "receipt_reference": {
      "type": "string"
    },
    "route_intent": {
      "type": "object"
    },
    "expiry_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
