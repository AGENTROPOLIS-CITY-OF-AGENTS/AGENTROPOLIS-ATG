{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/core/work-item.schema.json",
  "title": "ATG Work Item",
  "description": "Implementation-neutral work spine object for projects, missions, tickets, and agent tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "goal_id", "title", "state", "owner", "next_action"],
  "properties": {
    "work_id": {"type": "string", "pattern": "^work:[A-Za-z0-9._:-]{1,128}$"},
    "goal_id": {"type": "string", "pattern": "^goal:[A-Za-z0-9._:-]{1,128}$"},
    "parent_work_id": {"type": "string", "pattern": "^work:[A-Za-z0-9._:-]{1,128}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "district": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "assigned_agents": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^work:[A-Za-z0-9._:-]{1,128}$"}},
    "capability_requirements": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "state": {"type": "string", "enum": ["queued", "ready", "running", "blocked", "awaiting_approval", "verifying", "done", "failed", "cancelled"]},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 2048},
    "approval_state": {"type": "string", "enum": ["not_required", "pending", "approved", "denied", "expired"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "external_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "external_url": {"type": "string", "format": "uri"}
      }
    }
  }
}
