{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/atg/contracts/core/agentpack.schema.json",
  "title": "AGENTROPOLIS AgentPack",
  "description": "Portable commercial packaging contract for an agent or governed crew. AgentPack describes what the product is, what it may request, how it is distributed, and how it is metered. Runtime authority remains in the compiled Execution Envelope.",
  "type": "object",
  "required": ["schema_version", "id", "version", "identity", "capabilities", "governance", "distribution", "economics", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "brand": { "type": "string" },
        "publisher": { "type": "string" },
        "agent_did": { "type": "string" },
        "crew_members": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "models": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "runtime_classes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "context_contracts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "required": ["execution_envelope_version", "risk_tier"],
      "properties": {
        "execution_envelope_version": { "type": "string" },
        "risk_tier": { "type": ["string", "integer"] },
        "approval_policy": { "type": "string" },
        "denied_actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "must_understand": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "distribution": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["surface"],
            "properties": {
              "surface": { "type": "string" },
              "mode": { "type": "string" },
              "adapter": { "type": "string" },
              "minimum_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "configuration": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": true
          }
        },
        "white_label": { "type": "boolean", "default": false },
        "install_flow": { "type": "string", "default": "agent-link" }
      },
      "additionalProperties": true
    },
    "economics": {
      "type": "object",
      "required": ["pricing_model"],
      "properties": {
        "pricing_model": {
          "type": "string",
          "enum": ["free", "subscription", "per_run", "per_seat", "per_workspace", "usage", "outcome", "enterprise", "white_label", "reseller", "revenue_share"]
        },
        "currency": { "type": "string" },
        "price": { "type": "number", "minimum": 0 },
        "metering": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "revenue_share_bps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "receipt_profile": { "type": "string" },
        "evaluation_suite": { "type": "string" },
        "minimum_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "commit": { "type": "string" },
        "build_receipt": { "type": "string" },
        "created_by": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
