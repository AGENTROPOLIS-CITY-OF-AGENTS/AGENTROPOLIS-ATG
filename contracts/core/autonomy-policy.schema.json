{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/core/autonomy-policy.schema.json",
  "title": "ATG Autonomy Policy",
  "description": "Graduated autonomy policy for HERMES and specialist agents. This policy does not replace RFC-0001 authorization classes; every external action remains subject to the required A0-A4 authorization envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "level", "scope", "required_authorization_class"],
  "properties": {
    "policy_id": {"type": "string", "pattern": "^autonomy:[A-Za-z0-9._:-]{1,128}$"},
    "level": {"type": "string", "enum": ["L0_READ_ONLY", "L1_DRAFT", "L2_HUMAN_APPROVAL", "L3_BOUNDED_AUTOMATION", "L4_DELEGATED_BOUNDED", "L5_EXECUTIVE_DELEGATED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_classes"],
      "properties": {
        "action_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["read", "draft", "message", "publish", "modify", "schedule", "purchase", "transfer", "sign", "delete", "admin"]}},
        "recipients": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "systems": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "max_value": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "required_authorization_class": {"type": "string", "enum": ["A0_OBSERVE", "A1_REVERSIBLE", "A2_BOUNDED", "A3_IRREVERSIBLE", "A4_ROOT"]},
    "human_approval_required": {"type": "boolean"},
    "reversibility_required": {"type": "boolean"},
    "third_party_impact_check": {"type": "boolean", "default": true},
    "receipt_required": {"type": "boolean", "default": true},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
