{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UARC v0.3 External Participant (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "identity",
    "participation",
    "governance",
    "lifecycle"
  ],
  "properties": {
    "schema": {
      "const": "atg.uarc/v0.3"
    },
    "kind": {
      "const": "ExternalParticipant"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "owner_id",
        "tenant_id"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "origin"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "operating_system": {
          "type": "string"
        },
        "attestation_state": {
          "enum": [
            "unverified",
            "verified",
            "unsupported"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": "object"
        },
        "community": {
          "type": "object"
        },
        "experimental": {
          "type": "object"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_permission",
        "production_authorized"
      ],
      "properties": {
        "default_permission": {
          "const": "deny"
        },
        "production_authorized": {
          "const": false
        },
        "approval_required": {
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending_enrollment",
            "quarantined",
            "registered_unverified"
          ]
        }
      }
    }
  }
}
