{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/atg/contracts/media/photo-edit-request.v1.schema.json",
  "title": "ATG Identity-Preserving Photo Edit Request",
  "description": "Canonical message for profile atg.media.photo_edit.identity_preserving. Carries the edit contract, the immutable source-asset reference, and the authority references that must be resolved before DISPATCHED. ATG transports these references; it does not grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "request_id",
    "intent",
    "source_asset",
    "authority",
    "subject_lock",
    "preserve",
    "mutable",
    "forbid",
    "explicit_subject_changes",
    "retry_policy",
    "preview_required",
    "human_approval_required",
    "receipt_required"
  ],
  "properties": {
    "profile": { "type": "string", "const": "atg.media.photo_edit.identity_preserving" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "intent": {
      "type": "string",
      "enum": ["CAMERA_UPGRADE", "LIGHTING_REPAIR", "CINEMATIC_GRADE", "PROFESSIONAL_HEADSHOT"]
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "pattern": "^image/[a-z0-9.+-]+$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "mandate_ref", "capability_handle_ref", "policy_ref", "execution_envelope_ref"],
      "properties": {
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "type": { "type": "string", "enum": ["human", "agent", "service", "organization"] }
          }
        },
        "mandate_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capability_handle_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "policy_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "execution_envelope_ref": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "subject_lock": { "type": "boolean", "const": true },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/subject_attribute" }
    },
    "mutable": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "forbid": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "contains": { "const": "identity_drift" }
    },
    "explicit_subject_changes": {
      "type": "array",
      "uniqueItems": true,
      "description": "Subject attributes a human explicitly asked to change. Each must be removed from preserve, and each requires a human-attributed change request. identity, face_geometry, and body_proportions can never appear here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attribute", "requested_by", "request_digest"],
        "properties": {
          "attribute": {
            "type": "string",
            "enum": ["expression", "pose", "hair", "clothing", "skin_texture", "surroundings"]
          },
          "requested_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "const": "human" }
            }
          },
          "request_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "on_exhausted"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "on_exhausted": { "type": "string", "enum": ["FAILED_TERMINAL", "HUMAN_ESCALATION"] }
      }
    },
    "preview_required": { "type": "boolean", "const": true },
    "human_approval_required": { "type": "boolean" },
    "receipt_required": { "type": "boolean", "const": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "subject_attribute": {
      "type": "string",
      "enum": ["identity", "face_geometry", "body_proportions", "expression", "pose", "hair", "clothing", "skin_texture", "surroundings"]
    }
  }
}
