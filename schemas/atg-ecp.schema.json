{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/atg-ecp.schema.json",
  "title": "ATG:ECP Embodied Communication Packet",
  "type": "object",
  "required": ["profile", "version", "observations"],
  "properties": {
    "profile": {"const": "ATG:ECP"},
    "version": {"type": "string"},
    "source": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "channel": {"type": "string"}
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "signal"],
        "properties": {
          "family": {
            "enum": ["FACE", "BODY", "GESTURE", "GAZE", "VOICE", "AFFECT", "ATTENTION", "ENERGY", "SOCIAL_POSTURE", "COMMUNICATIVE_INTENT"]
          },
          "signal": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "mode": {"enum": ["observed", "declared", "inferred", "rendered"]}
        },
        "additionalProperties": true
      }
    },
    "affect": {
      "type": "object",
      "properties": {
        "valence": {"type": "number", "minimum": -1, "maximum": 1},
        "arousal": {"type": "number", "minimum": 0, "maximum": 1},
        "dominance": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "basis": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "intent": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "mode": {"enum": ["declared", "inferred"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "context": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "rendering": {
      "type": "object",
      "properties": {
        "emoji": {"type": "array", "items": {"type": "string"}},
        "text": {"type": "string"},
        "voice": {"type": "object", "additionalProperties": true},
        "avatar": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
